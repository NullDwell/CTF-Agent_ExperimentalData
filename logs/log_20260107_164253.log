- 命令: {"tool": "sandbox_python_exec", "purpose": "遍历候选密码，比对Hash，解密Flag", "arguments": {"code": "import hashlib\n\n# 目标哈希值\nwith open('/home/gem/workspace/attachments/level3.hash.bin', 'rb') as f:\n    target_hash = f.read()\n\n# 候选密码列表\npos_pw_list = [\"6997\", \"3ac8\", \"f0ac\", \"4b17\", \"ec27\", \"4e66\", \"865e\"]\n\n# 加密flag\nwith open('/home/gem/workspace/attachments/level3.flag.txt.enc', 'rb') as f:\n    flag_enc = f.read()\n\n# str_xor函数逻辑\ndef str_xor(secret, key):\n    new_key = key\n    i = 0\n    while len(new_key) < len(secret):\n        new_key = new_key + key[i]\n        i = (i + 1) % len(key)\n    # secret是bytes，需要解码为字符串与key处理\n    # 但输入是bytes，输出需要处理\n    # 根据原脚本，secret是decode()后的字符串，key是用户输入\n    # 我们在脚本中模拟这一过程\n    return ''.join([chr(c ^ ord(k)) for c, k in zip(secret, new_key)])\n\nfound_pw = None\n\nfor pw in pos_pw_list:\n    # 计算MD5\n    m = hashlib.md5()\n    m.update(pw.encode())\n    if m.digest() == target_hash:\n        found_pw = pw\n        break\n\nif found_pw:\n    print(f\"Found password: {found_pw}\")\n    # 解密\n    try:\n        # flag_enc是bytes，需要decode为字符串\n        # str_xor函数设计为处理字符串\n        flag_str = flag_enc.decode()\n        decrypted = str_xor(flag_str, found_pw)\n        print(f\"Flag: {decrypted}\")\n    except Exception as e:\n        print(f\"Decryption error: {e}\")\nelse:\n    print(\"Password not found in list.\")"}}
