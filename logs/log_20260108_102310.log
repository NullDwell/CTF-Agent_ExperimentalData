xcept ValueError:\n                        pass\n                \n                # Check for flag pattern\n                if \"picoCTF{\" in buffer:\n                    print(\"Flag found!\")\n                    break\n                    \n            except socket.timeout:\n                # If timeout, maybe we need to wait for next prompt or connection dropped\n                continue\n            except Exception as e:\n                print(f\"Error: {e}\")\n                break\n                \n        s.close()\n        \n    except Exception as e:\n        print(f\"Connection failed: {e}\")\n\nif __name__ == \"__main__\":\n    solve()\n"}}
