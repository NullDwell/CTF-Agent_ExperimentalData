\n                    s.sendall((decoded + '\\n').encode())\n                    buffer = \"\"\n                    time.sleep(0.2)\n                    continue\n\n                # 3. Check for Flag\n                if \"picoCTF{\" in buffer:\n                    flag_match = re.search(r\"picoCTF\\{[^}]+\\}\", buffer)\n                    if flag_match:\n                        print(f\"FLAG FOUND: {flag_match.group(0)}\")\n                        break\n                \n                # 4. Check for hex prompt style if present\n                hex_match = re.search(r\"Please give me the ([0-9a-fA-F ]+?) as a word\", buffer)\n                if hex_match:\n                    hex_str = hex_match.group(1)\n                    print(f\"Hex detected: {hex_str}\")\n                    decoded = bytes.fromhex(hex_str.replace(' ', '')).decode('utf-8', errors='ignore')\n                    print(f\"Decoded hex to: {decoded}\")\n                    s.sendall((decoded + '\\n').encode())\n                    buffer = \"\"\n                    time.sleep(0.2)\n                    continue\n\n            except socket.timeout:\n                print(\"Timeout waiting for data, checking buffer...\")\n                continue\n            except Exception as e:\n                print(f\"Error in loop: {e}\")\n                break\n        \n        s.close()\n        \n    except Exception as e:\n        print(f\"Connection failed: {e}\")\n\nif __name__ == \"__main__\":\n    solve()\n"
