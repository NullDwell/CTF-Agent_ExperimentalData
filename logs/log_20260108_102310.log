- 命令: {"tool": "sandbox_python_exec", "purpose": "Execute an automated script to interact with the CTF server, continuously decoding binary prompts and submitting answers to retrieve the flag.", "arguments": {"code": "import socket\nimport re\nimport time\n\ndef solve():\n    host = 'fickle-tempest.picoctf.net'\n    port = 64686\n    \n    try:\n        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n        s.settimeout(5.0)\n        s.connect((host, port))\n        print(f\"Connected to {host}:{port}\")\n        \n        buffer = \"\"\n        while True:\n            try:\n                chunk = s.recv(4096).decode('utf-8', errors='ignore')\n                if not chunk:\n                    print(\"Connection closed by remote host.\")\n                    break\n                \n                print(chunk)\n                buffer += chunk\n                \n                # Look for binary patterns (groups of 8 bits separated by spaces)\n                pattern = r\"([01]{8}(\\s+[01]{8})*)\"\n                match = re.search(pattern, buffer)\n                \n                if match:\n                    binary_str = match.group(1)\n                    print(f\"Found binary: {binary_str}\")\n                    \n                    # Decode binary to ASCII word\n                    try:\n                        bits = binary_str.split()\n                        decoded = ''.join([chr(int(b, 2)) for b in bits])\n                        print(f\"Decoded answer: {decoded}\")\n                        \n                        # Send the answer\n                        s.sendall((decoded + '\\n').encode())\n                        print(f\"Sent: {decoded}\")\n                        \n                        # Clear buffer to avoid reprocessing the same prompt\n                        buffer = \"\"\n                        \n                        # Short sleep to allow server processing\n                        time.sleep(0.5)\n                    except ValueError:\n                        pass\n                \n                # Check for flag pattern\n                if \"picoCTF{\" in buffer:\n                    print(\"Flag found!\")\n                    break\n                    \n            except socket.timeout:\n                # If timeout, maybe we need to wait for next prompt or connection dropped\n                continue\n            except Exception as e:\n                print(f\"Error: {e}\")\n                break\n                \n        s.close()\n        \n    except Exception as e:\n        print(f\"Connection failed: {e}\")\n\nif __name__ == \"__main__\":\n    solve()\n"}}
