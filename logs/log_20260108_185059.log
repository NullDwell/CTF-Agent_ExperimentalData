    \\n    # 过滤出可能包含flag的长数字序列\\n    potential_sequences = [m for m in matches if len(m) > 20]\\n    \\n    print(f\\"Found {len(potential_sequences)} potential number sequences.\\")\\n    \\n    for seq in potential_sequences[:5]:\\n        # 将字符串按空格分割\\n        parts = seq.split()\\n        # 尝试将每个数字转换为ASCII字符\\n        try:\\n            decoded = \'\'.join([chr(int(p)) for p in parts])\\n            print(f\\"Sequence: {seq[:50]}... -> Decoded: {decoded}\\")\\n            if \'PICOCTF\' in decoded:\\n                print(f\\"\\\\n*** FLAG FOUND: {decoded} ***\\")\\n                break\\n        except ValueError:\\n            continue\\n            \\n    if not potential_sequences:\\n        print(\\"No suitable number sequences found.\\")\\n        # 调试：打印前1000个字符以查看是否有遗漏\\n        print(f\\"First 1000 chars of printable data: {text[:1000]}\\")\\n        \\nexcept Exception as e:\\n    print(f\\"Error: {e}\\")"}}\n- 输出:\ntype=\'text\' text=\'Found 0 potential number sequences.\\nNo suitable number sequences found.\\nFirst 1000 chars of printable data: PNGIHDRW6gsRGBgAMAapHYs%%IR$IDATx^=R(B4FyLx9<,<xhePrXN{w~OJ^O~FK(I<v*#I*%j_Za/T"`+H+<`i_\\\\{:.jx(ycannhP\\\'+nY_38a%F=`;]zOE;()A]|]<v??WQLb.9*%5p-TB&e{WQf<2\\\'9Uv3oEe\\\\y][H?rFsL%LPdKvq+c&#FrQGV<u(2x0W0/hp<;\\\'}dj,b@%_%z9rHC.B(/a0so^|o\\\'{24_N^W6T*b@(`!Gyern&[=V)pFff}[Q+$@mZ>^_yIu/{wrP-t</L^S^:F|j-(.U,ExFp6)_/?IK|^voQ\\\\AWTp1_mLfg$fQYtu@1g[bd97<T1-q1xhEQbud+O|`eZxw6LX^C^*i<O1+as<*J_Mj3>\\\\p~}FILO~;pm`c(J?=?GXQ;D6><~.\\\'aa^0u4\\\\bEJ1O]7- BE)A$~[^n}rC2GeI\\\\v*yt:p;&LawN+Fz\\\'GFW@JJ(1!ay}+g*9RAg4JGPZVA["@"Ok+{A[+\\\\w[\\\'yA!ET)T:w:-b _/8Tl+a*"FI<f/`aXT6-\\\'Z~fc)sMM.3nIFP63x[TmB\\\\/]NK@{bF/?Q[.|H{wO7Aa+C-eDB{\\\'k_JhS$YYcJXe6rxj)j$A-(ERLvX]0&aFrH%7`W{I0=4VO3mypGul)yXdde2?8u(>vFWuED/sa#h:w{\\\\KS=#T<uy8g#C|9\\\\K[7.-mQuI{RCPIB6w5."29S8IVV(I$Kp%q`C5UKZ`=1!+Um.ztBa#[<kxdtWV:q7t]CI.n/xp@AgsK+h _AYpPux_66@)8Kv:dq.j4[)7*j[7b6"S^kp]"lG) h.a,%ccAS?XV6Atq80^ua]p@}Fcs])peykn`FhzjEagHt2,75_\\\\(lgqlIY Z]0TP?Ug