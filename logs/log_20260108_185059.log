过滤掉过短的字符串，只保留长字符串\\n    # Base64字符串通常较长，且可能包含\'=\'结尾\\n    potential_strings = [s for s in text.split() if len(s) > 20]\\n    \\n    print(f\\"Found {len(potential_strings)} potential strings (length > 20).\\")\\n    \\n    # 重点关注可能包含Base64特征的字符串\\n    candidates = []\\n    for s in potential_strings:\\n        if all(c in \'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=\' for c in s):\\n            candidates.append(s)\\n            \\n    print(f\\"Found {len(candidates)} potential Base64 strings.\\")\\n    \\n    if candidates:\\n        # 打印最长的几个候选，很可能就是flag\\n        candidates.sort(key=len, reverse=True)\\n        for i, s in enumerate(candidates[:5]):\\n            print(f\\"Candidate {i+1}: {s}\\")\\n            # 尝试Base64解码\\n            try:\\n                import base64\\n                decoded = base64.b64decode(s).decode(\'utf-8\', errors=\'ignore\')\\n                print(f\\"Decoded: {decoded}\\")\\n                if \'PICOCTF\' in decoded:\\n                    print(f\\"\\\\n*** FLAG FOUND: {decoded} ***\\")\\n            except:\\n                pass\\n    else:\\n        print(\\"No potential Base64 strings found in the extracted text.\\")\\n        # 打印前500个字符用于调试\\n        print(f\\"First 500 chars of extracted text: {text[:500]}\\")\\n        \\nexcept Exception as e:\\n    print(f\\"Error: {e}\\")"}}\n- 输出:\ntype=\'text\' text=\'Found 541 potential strings (length > 20).\\nFound 0 potential Base64 strings.\\nNo potential Base64 strings found in the extracted text.\\nFirst 500 chars of extracted text: PNG\\n\\nIHDRW6gsRGBgAMAapHYs%%IR$IDATx^=R(B4FyLx9<,<xhePrXN{w~OJ^O~FK(I<v*#I*%j_Za/T"`+H+<`i_\\\\{:.jx(ycannhP\\\'+nY\\n_38a%F=`;]zOE;()A]|]<v??WQLb.9*%5p-TB&e{WQf<2\\\'9Uv3oEe\\\\y][H?rFsL%LPdKvq\\n+c&#FrQGV<u(2x0W0\\n/hp<;\\\'}dj,b@%_%z9rHC.B(/a0so^|o\\\'{24_N^W6T\\n*b@(`!Gyern&[=V)pFff}[Q+$@mZ\\n>^_yIu/{\\nwrP-t</L^S^:F|j-(.U,ExFp6)_/?IK|^voQ\\\\AWTp1_mLfg$fQYtu@1g[bd97<T1-q1xhEQbud+O|`eZxw6LX^C^*i<O1+as<*J_Mj3>\\\\p~}