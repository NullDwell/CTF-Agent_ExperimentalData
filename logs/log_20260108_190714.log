步骤 14: {"tool": "sandbox_python_exec", "purpose": "编写 Python 脚本，针对疑似 TTComp (RLE) 格式的 Zlib 数据进行解码，尝试提取 Flag。", "arguments": {"code": "import zlib\nimport sys\nimport re\n\n# 1. 读取 PNG 并提取 Zlib 数据\nfile_path = '/home/gem/workspace/attachments/flag.png'\nwith open(file_path, 'rb') as f:\n    data = f.read()\n\n# 偏移 0x5B (91)\ncompressed_data = data[91:]\n\ntry:\n    # 2. Zlib 解压\n    zlib_data = zlib.decompress(compressed_data)\n    print(f'Zlib解压长度: {len(zlib_data)}')\n    \n    # 3. 尝试 RLE 解压\n    # 常见的 RLE 格式: <count, val> 或者 <val, count>，1字节或2字节\n    # 头部: 00 04 04 5c ... \n    # 如果是 <count=1 byte> <val=1 byte>:\n    # 00 04 -> count=0, val=4 (无效)\n    # 如果是 <val=1 byte> <count=1 byte>:\n    # 00 04 -> val=0, count=4 (4个00)\n    # 04 5c -> val=4, count=92 (92个04)\n    # 04 8c -> val=4, count=140 (140个04)\n    # 这看起来最合理，因为大量的 04 会生成重复数据。\n    \n    # 让我们先尝试 <val> <count> (1 byte each) 模式\n    output = bytearray()\n    i = 0\n    length = len(zlib_data)\n    \n    # 预处理：如果头部有奇怪的 00，可能需要跳过\n    # 但让我们先严格解析\n    \n    while i < length - 1:\n        val = zlib_data[i]\n        count = zlib_data[i+1]\n        \n        # 如果 count 是 0，可能意味着结束或特殊指令，或者是数据损坏\n        # 如果 count 极大，可能也是损坏\n        if count == 0:\n            # 可能是填充或者是另一种结构的开始，这里选择跳过这一对，或者只写入 val\n            # 鉴于头部 00 04，如果 00 是 val，04 是 count，那么输出 4个 00\n            output.extend([val] * count) # 0次\n            i += 2\n            continue\n            \n        # 如果 count 太大，可能不是这种模式，为了安全，限制一下\n        if count > 200:\n             # 如果异常大，可能不是 RLE，或者是 <count=2 bytes> 模式\n             # 我们先尝试仅输出当前字节，并移一位\n             output.append(val)\n             i += 1\n             continue\n             \n        output.extend([val] * count)\n        i += 2\n    \n    print(f'初步 RLE (<val><count>) 解压后长度: {len(output)}')\n    \n    # 查找 Flag\n    if b'CTF{' in output:\n        start = output.find(b'CTF{')\n        end = output.find(b'}', start)\n        if end != -1:\n            print(f'FLAG: {output[start:end+1].decode()}')\n        else:\n            print(f'Flag start: {output[start:start+20]}')\n    else:\n        # 如果没找到，尝试另一种模式 <count><val>\n        print('未找到 CTF{...}，尝试 <count><val> 模式...')\n        output2 = bytearray()\n        i = 0\n        while i < length - 1:\n            count = zlib_data[i]\n            val = zlib_data[i+1]\n            if count > 200:\n                output2.append(count)\n                i += 1\n                continue\n            output2.extend([val] * count)\n            i += 2\n        \n        if b'CTF{' in output2:\n            start = output2.find(b'CTF{')\n            end = output2.find(b'}', start)\n            if end != -1:\n                print(f'FLAG (Method 2): {output2[start:end+1].decode()}')\n        else:\n            print(f'未找到Flag。调试输出 (前50字节 Hex): {output[:50].hex()}')\n            \nexcept Exception as e:\n    print(f'Error: {e}')\n    import traceback\n    traceback.print_exc()"}}
