import zlib
import sys

file_path = '/home/gem/workspace/attachments/flag.png'
with open(file_path, 'rb') as f:
    data = f.read()

# 提取并解压 Zlib 数据
compressed_data = data[91:]
try:
    zlib_data = zlib.decompress(compressed_data)
    print(f'Zlib 解压成功，长度: {len(zlib_data)}')
    
    # 尝试多种简单的字节操作来还原 Flag
    # 假设 Flag 被某种单字节异或或位移隐藏
    
    # 1. 尝试反转位 (NOT)
    xored = bytes([b ^ 0xFF for b in zlib_data])
    if b'CTF{' in xored:
        start = xored.find(b'CTF{')
        end = xored.find(b'}', start)
        if end != -1:
            print(f'Flag found via XOR 0xFF: {xored[start:end+1].decode()}')
            sys.exit(0)
            
    # 2. 尝试 XOR 0x80 (反转最高位)
    xored = bytes([b ^ 0x80 for b in zlib_data])
    if b'CTF{' in xored:
        start = xored.find(b'CTF{')
        end = xored.find(b'}', start)
        if end != -1:
            print(f'Flag found via XOR 0x80: {xored[start:end+1].decode()}')
            sys.exit(0)

    # 3. 尝试 XOR 0x04 (因为数据中很多04)
    xored = bytes([b ^ 0x04 for b in zlib_data])
    if b'CTF{' in xored:
        start = xored.find(b'CTF{')
        end = xored.find(b'}', start)
        if end != -1:
            print(f'Flag found via XOR 0x04: {xored[start:end+1].decode()}')
            sys.exit(0)

    # 4. 尝试 XOR 0x5C (因为数据中有5C)
    xored = bytes([b ^ 0x5C for b in zlib_data])
    if b'CTF{' in xored:
        start = xored.find(b'CTF{')
        end = xored.find(b'}', start)
        if end != -1:
            print(f'Flag found via XOR 0x5C: {xored[start:end+1].decode()}')
            sys.exit(0)

    # 5. 尝试 Sub 0x80 (数值减 128)
    subbed = bytes([b - 0x80 if b >= 0x80 else b for b in zlib_data])
    if b'CTF{' in subbed:
        start = subbed.find(b'CTF{')
        end = subbed.find(b'}', start)
        if end != -1:
            print(f'Flag found via Sub 0x80: {subbed[start:end+1].decode()}')
            sys.exit(0)

    # 6. 尝试 Add 0x80
    added = bytes([(b + 0x80) & 0xFF for b in zlib_data])
    if b'CTF{' in added:
        start = added.find(b'CTF{')
        end = added.find(b'}', start)
        if end != -1:
            print(f'Flag found via Add 0x80: {added[start:end+1].decode()}')
            sys.exit(0)

    # 如果上述简单操作都失败，我们再看是否是 RLE 后 XOR
    # 但为了保持在单步限制内，我们先输出这些尝试的结果
    
    print("No flag found with simple byte operations on raw zlib data.")

except Exception as e:
    print(f'Error: {e}')
