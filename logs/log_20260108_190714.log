- 目的: 编写 Python 脚本以流式 RLE 解码（Value, Count 模式）Zlib 数据，并搜索 Flag
- 命令: {"tool": "sandbox_python_exec", "purpose": "编写 Python 脚本以流式 RLE 解码（Value, Count 模式）Zlib 数据，并搜索 Flag", "arguments": {"code": "import zlib\nimport sys\n\nfile_path = '/home/gem/workspace/attachments/flag.png'\ntry:\n    with open(file_path, 'rb') as f:\n        data = f.read()\n    \n    # 提取 Zlib 数据 (偏移 0x5B，即 91 字节)\n    compressed_data = data[91:]\n    zlib_data = zlib.decompress(compressed_data)\n    \n    stream = bytearray()\n    i = 0\n    length = len(zlib_data)\n    \n    # 遍历数据对 <Value, Count>\n    while i < length - 1:\n        val = zlib_data[i]\n        count = zlib_data[i+1]\n        \n        # 只处理非填充字节，避免内存爆炸\n        # 填充字节通常为 0x00 和 0x04\n        if val != 0x00 and val != 0x04:\n            # 追加解码后的数据块\n            stream.extend(bytes([val]) * count)\n            \n            # 实时搜索 Flag\n            if b'CTF{' in stream:\n                start = stream.find(b'CTF{')\n                # 截取足够长的一段以包含结束符\n                segment = stream[start:start+200]\n                if b'}' in segment:\n                    end = segment.find(b'}')\n                    flag = segment[:end+1].decode('utf-8', errors='ignore')\n                    print(f\"Found Flag: {flag}\")\n                    sys.exit(0)\n                else:\n                    # 如果未找到结束符，打印上下文供分析\n                    print(f\"Found CTF{{ context: {segment}\")\n        \n        i += 2\n        \n    print(\"No flag found with current logic. Stream head:\", stream[:100])\n\nexcept Exception as e:\n    print(f\"Error: {e}\")"}}
