步骤 7: {"tool": "sandbox_python_exec", "purpose": "执行纯Python脚本，使用二分法计算大整数立方根，暴力搜索系数k以恢复M并解密flag。", "arguments": {"code": "import os\n\n# 附件中的参数（已移除换行符）\nN = \n\ne = 3\n\nc = \n\n# 二分法计算整数立方根\n\ndef integer_cbrt(n):\n    if n < 0:\n        return -integer_cbrt(-n)\n    if n == 0:\n        return 0\n    \n    # 估算上界：n.bit_length() / 3 是 x^3 为 n 时 x 的近似位数\n    # 加上1作为缓冲\n    high = 1 << ((n.bit_length() + 2) // 3 + 1)\n    low = 0\n    \n    while low <= high:\n        mid = (low + high) // 2\n        mid_cubed = mid * mid * mid\n        \n        if mid_cubed == n:\n            return mid\n        elif mid_cubed < n:\n            low = mid + 1\n        else:\n            high = mid - 1\n            \n    return None\n\nprint(\"[*] Starting brute force for k (range 0-100)...\")\nfound = False\n\nfor k in range(0, 101):\n    val = c + k * N\n    \n    # 检查 val 是否为完全立方数\n    m = integer_cbrt(val)\n    \n    if m is not None:\n        print(f\"[+] Found k={k}, M={m}\")\n        \n        # 尝试将 M 转换为字节串\n        try:\n            # 计算字节长度 (注意 M 可能很大，需要根据 bit_length 计算)\n            byte_len = (m.bit_length() + 7) // 8\n            m_bytes = m.to_bytes(byte_len, 'big')\n            \n            # 移除可能存在的前导填充字节 (0x00)\n            while m_bytes.startswith(b'\\x00'):\n                m_bytes = m_bytes[1:]\n                \n            # 尝试解码为 ASCII/UTF-8\n            flag = m_bytes.decode('utf-8', errors='ignore')\n            print(f\"[+] Decoded: {flag}\")\n            \n            if 'pico' in flag:\n                print(f\"\\n[!!!] FLAG FOUND: {flag}\")\n                found = True\n                break\n            \n        except Exception as e:\n            print(f\"[-] Decoding error for k={k}: {e}\")\n\nif not found:\n    print(\"[-] Flag not found in k=0-100. Try adjusting range if needed.\")"}}
