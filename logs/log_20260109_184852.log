it_length()}\\")\\n    print(f\\"[+] Parsed e: {e}\\")\\n    print(f\\"[+] Parsed c (bits): {c.bit_length()}\\")\\n\\n    # 检查 e 是否为 3\\n    if e != 3:\\n        print(f\\"[!] Warning: e is {e}, expected 3 for standard Hastad/Low Exp attack. Trying anyway.\\")\\n\\n    # 暴力搜索 k\\n    # M^3 = c + k*N\\n    print(\\"[*] Searching for k in range 1-20...\\")\\n    found = False\\n    for k in range(1, 21):\\n        val = c + k * N\\n        \\n        # 计算整数立方根\\n        # 使用整数二分法或 pow(val, 1/3) 如果数字不大，但这里数字很大\\n        # Python 3.11+ 的 int 有 bit_length，这里手写二分法最稳妥\\n        \\n        low = 1\\n        high = val # 上界可以是 val，但太大了，实际上 M < N^(1/3) * k^(1/3)\\n        # 估算上界: M 约为 N^(1/3) + k*N/3N^(2/3)\\n        # 粗略上界: val^(1/3) + 2\\n        \\n        # 使用 gmpy2 如果可用，否则用二分\\n        try:\\n            import gmpy2\\n            root, exact = gmpy2.iroot(val, 3)\\n            if exact:\\n                M = int(root)\\n                print(f\\"[+] Found solution: k={k}, M={M}\\")\\n                found = True\\n                break\\n        except ImportError:\\n            # 纯 Python 二分查找立方根\\n            # 优化上界：3* (val.bit_length()/3) 相当于 val^(1/3) 的近似位数\\n            high = 1 << ((val.bit_length() + 2) // 3 + 1)\\n            while low <= high:\\n                mid = (low + high) // 2\\n                mid_cubed = mid * mid * mid\\n                if mid_cubed == val:\\n                    M = mid\\n                    print(f\\"[+] Found solution: k={k}, M={M}\\")\\n                    found = True\\n                    break\\n                elif mid_cubed < val:\\n                    low = mid + 1\\n                else:\\n                    high = mid - 1\\n            if found:\\n                break\\n\\n    if found:\\n        # 转换 M 为字节\\n        # 注意：M 可能包含填充字节，或者直接就是 ASCII\\n        length = (M.bit_length() + 7) // 8\\n        m_bytes = M.to_bytes(length, byteorder=\'big\')\\n        \\n        # 尝试去除前导的 \\\\x00\\n        m_bytes = m_bytes.lstrip(b