步骤 18:
- 目的: 提取磁盘头部及偏移量 125952 附近的数据，清洗后尝试解码 Base64 变种字符串以寻找 Flag。
- 命令: {"tool": "sandbox_python_exec", "purpose": "提取磁盘头部及偏移量 125952 附近的数据，清洗后尝试解码 Base64 变种字符串以寻找 Flag。", "arguments": {"code": "import base64\nimport re\n\nimage_path = '/home/gem/workspace/attachments/suspicious.dd.sda1'\n\ndef find_flag(offset, length=256):\n    try:\n        with open(image_path, 'rb') as f:\n            f.seek(offset)\n            data = f.read(length)\n        \n        # 清洗数据：只保留可打印字符，并替换 > 为 +\n        cleaned = \"\"\n        for b in data:\n            if 32 <= b < 127:\n                c = chr(b)\n                if c == '>':\n                    c = '+'\n                cleaned += c\n        \n        # 查找 Base64 字符串 (长度 > 16)\n        b64_matches = re.findall(r'[A-Za-z0-9+/=]{16,}', cleaned)\n        \n        for match in b64_matches:\n            # 补全填充\n            pad = len(match) % 4\n            if pad > 0:\n                match += '=' * (4 - pad)\n            try:\n                decoded = base64.b64decode(match)\n                if b'flag' in decoded or b'{' in decoded:\n                    print(f\"[+] Found flag in offset {offset}: {decoded.decode('utf-8', errors='ignore')}\")\n                    return True\n            except:\n                pass\n    except Exception as e:\n        print(f\"Error at offset {offset}: {e}\")\n    return False\n\n# 1. 检查头部 (步骤 9 提示的乱码区域，假设在 0x20 - 0x80 之间)\nprint(\"[*] Checking Header area (approx 0x20)...\")\nif find_flag(0x20): exit(0)\n\n# 2. 检查 grep 找到的物理偏移量 125952\nprint(\"[*] Checking offset 125952 (grep hit)...\")\nif find_flag(125952): exit(0)\n\n# 3. 检查 125952 附近的后续字节 (因为有两个连续的 {)\nprint(\"[*] Checking offset 125956...\")\nif find_flag(125956): exit(0)\n\nprint(\"[*] No flag found in these specific regions. Dumping cleaned bytes around 125952 for manual review:\")\nwith open(image_path, 'rb') as f:\n    f.seek(125952)\n    print(f.read(64))"}}
