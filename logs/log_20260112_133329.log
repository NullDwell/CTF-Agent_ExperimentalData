步骤 20:
- 目的: 在磁盘头部搜索包含 '{' 和 '>' 的乱码模式，应用字符替换解码 Base64 以寻找 Flag
- 命令: {"tool": "sandbox_python_exec", "purpose": "在磁盘头部搜索包含 '{' 和 '>' 的乱码模式，应用字符替换解码 Base64 以寻找 Flag", "arguments": {"code": "import base64\nimport re\n\nimage_path = '/home/gem/workspace/attachments/suspicious.dd.sda1'\n\n# 读取磁盘头部数据，跳过 EXT4 引导扇区\nwith open(image_path, 'rb') as f:\n    f.seek(1024)\n    data = f.read(8192) # 读取 8KB 头部数据\n\n# 将二进制数据转换为字符串，处理非法字符\n# 历史线索：'>' 可能代表 '+'，可能存在其他非 Base64 字符作为分隔\n# 我们只保留 Base64 字符集及扩展字符（>, =, 等）\n\nprocessed = \"\"\nfor b in data:\n    if 32 <= b < 127:\n        c = chr(b)\n        if c == '>':\n            processed += '+'\n        elif c in 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/= ':\n            processed += c\n        else:\n            # 遇到其他字符视为分隔符\n            processed += ' '\n    elif b == 0:\n        processed += ' '\n\n# 将连续的 Base64 字符串分割\nparts = processed.split()\n\nprint(f\"Found {len(parts)} potential data chunks.\")\n\nfor part in parts:\n    if len(part) < 16: continue\n    if '{' not in part and 'p' not in part: continue # 快速过滤\n    \n    # 补全 Base64 填充\n    pad = len(part) % 4\n    if pad > 0:\n        part += '=' * (4 - pad)\n    \n    try:\n        decoded = base64.b64decode(part)\n        # 检查解码结果是否包含 flag 特征\n        if b'flag' in decoded or b'{' in decoded:\n            print(f\"[+] Found Flag: {decoded.decode('utf-8', errors='ignore')}\")\n            break\n        # 打印包含 'p' 的可疑解码结果供分析\n        if b'p' in decoded and b't' in decoded:\n             print(f\"[*] Suspicious decode: {decoded}\")\n    except Exception as e:\n        # 忽略解码失败的片段\n        pass\n"}}
