步骤 19:
- 目的: 在磁盘头部的特定偏移量附近搜索Base64变种乱码，进行清洗和解码以获取flag
- 命令: {"tool": "sandbox_python_exec", "purpose": "在磁盘头部的特定偏移量附近搜索Base64变种乱码，进行清洗和解码以获取flag", "arguments": {"code": "import base64\nimport re\n\nimage_path = '/home/gem/workspace/attachments/suspicious.dd.sda1'\n\n# 重点搜索范围：跳过EXT4引导扇区（1024字节）后的头部区域\n# 步骤9提示乱码在头部，且包含 '{' 和 '>'\n\nwith open(image_path, 'rb') as f:\n    # 读取1024字节后的4KB数据\n    f.seek(1024)\n    data = f.read(4096)\n\n# 将二进制数据转换为可打印字符串，并处理混淆\n# 假设 '>' 是 '+' 的替换（标准Base64变种）\n# 忽略空格和其他非Base64字符\nprocessed_string = \"\"\nfor b in data:\n    if 32 <= b < 127:\n        c = chr(b)\n        if c == '>':\n            processed_string += '+'\n        elif c == ' ' or c == '\\r' or c == '\\n':\n            continue\n        else:\n            processed_string += c\n\n# 查找可能包含 Base64 数据的区域，特别是包含 flag 格式 '{' 的\n# 我们截取包含 '{' 的周围字符串进行解码\nmatches = re.finditer(r'[A-Za-z0-9+/=]{10,}', processed_string)\n\nfor match in matches:\n    b64_candidate = match.group(0)\n    # 只有当候选字符串包含 '{' 或其解码可能包含 flag 时才尝试解码\n    if '{' in b64_candidate or '+' in b64_candidate:\n        # 补全填充\n        pad = len(b64_candidate) % 4\n        if pad > 0:\n            b64_candidate += '=' * (4 - pad)\n        \n        try:\n            decoded = base64.b64decode(b64_candidate)\n            # 检查解码结果是否包含 flag 特征\n            if b'flag' in decoded or b'{' in decoded:\n                print(f\"[+] Flag found: {decoded.decode('utf-8', errors='ignore')}\")\n                break\n        except Exception as e:\n            pass"}}
