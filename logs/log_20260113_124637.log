o consume (KEY_LEN - l_flag) bytes to wrap to 0\n        wrap_len = KEY_LEN - l_flag\n        print(f\"Sending {wrap_len} bytes to wrap key pointer...\")\n        \n        # Send wrap payload (zeros)\n        # We send in chunks to avoid issues, but let's try one big line if allowed.\n        # The server uses input().rstrip(), so we append newline.\n        wrap_payload = (b'0' * (wrap_len - 1)) + b'\\n'\n        s.sendall(wrap_payload)\n        \n        # Discard the garbage response from the wrap\n        # Should receive \"Here ya go!\\n...\\n\"\n        garbage = s.recv(1024)\n        \n        # Step 3: Encrypt C_flag to get Flag\n        print(f\"Sending C_flag to recover flag...\")\n        s.sendall(c_flag + b'\\n')\n        \n        final_data = s.recv(1024).decode('utf-8', errors='ignore')\n        print(f\"Response: {final_data}\")\n        \n        # Parse result\n        match = re.search(r'[0-9a-f]{32,}', final_data)\n        if match:\n            flag_cipher = match.group(0)\n            flag_bytes = bytes.fromhex(flag_cipher)\n            flag = flag_bytes.decode('utf-8', errors='ignore')\n            return flag\n        \n        s.close()\n    except Exception as e:\n        print(f\"Error: {e}\")\n        return None\n\nflag = get_flag()\nif flag:\n    print(f\"\\n\\nRecovered Flag: {flag}\")\nelse:\n    print(\"Failed to recover flag.\")"}}
