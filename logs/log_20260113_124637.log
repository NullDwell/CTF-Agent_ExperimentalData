\n    lines = data.strip().split(\'\\\\n\')\\n    # The encrypted flag is usually the second line after the banner\\n    # But looking at the previous output, the server sends the flag immediately.\\n    # We look for the hex string that looks like the flag ciphertext.\\n    \\n    used_key_hex = None\\n    for line in lines:\\n        if len(line) >= 32 and all(c in \'0123456789abcdef\' for c in line):\\n            used_key_hex = line[:32] # Flag is 16 bytes -> 32 hex chars\\n            break\\n            \\n    if not used_key_hex:\\n        print(\\"Could not find used_key in response.\\")\\n        print(\\"Raw response:\\", data)\\n        exit()\\n        \\n    used_key = bytes.fromhex(used_key_hex)\\n    print(f\\"Step 1 Success. Used Key: {used_key.hex()}\\")\\n\\n    # Step 2: Connect again for second round\\n    # The key pointer is now at 16 (len(flag)).\\n    # We send 16 bytes. The server will use key[16:32].\\n    # Wait, previous analysis suggested we need to wrap or manipulate used_key.\\n    # Let\'s re-read the exploit logic from hints.\\n    # Hint says: \\"make this a 2x pad\\".\\n    # The vulnerability in the provided otp.py seems to be about the pointer.\\n    # Actually, wait. The `startup` function sets `key_location = stop` (16).\\n    # The first `encrypt` call uses `key_location` starting at 16.\\n    # So if we send 16 bytes in Round 2, we get `flag_part2 ^ key[16:32]` (if flag was 16).\\n    # But we want `flag ^ key[0:16]`.\\n    # To get `key[0:16]` again, we need `key_location` to wrap around.\\n    # KEY_LEN is 50000.\\n    # We can\'t send 50000 bytes easily if the server limits input.\\n    # However, the `encrypt` function does `key_location = stop`.\\n    # If we send 50000 - 16 bytes, `key_location` becomes 49984.\\n    # Then next 16 bytes wrap to 0.\\n    # But wait, the previous step in the history said: \\"send 0x00 to get used_key\\".\\n    # That implies the server returns `key[0:16] ^ 0x00` -> `key[0:16]` immediately