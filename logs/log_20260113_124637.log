           raise ValueError(\"Could not find flag ciphertext\")\n            \n            c_flag_hex = match.group(1)\n            c_flag = bytes.fromhex(c_flag_hex)\n            flag_len = len(c_flag)\n            print(f\"[+] Found C_flag ({flag_len} bytes): {c_flag_hex[:32]}...\")\n        except Exception as e:\n            print(f\"[-] Error parsing C_flag: {e}\")\n            return\n\n        # Step 2: Wrap around\n        # Send enough data to consume remaining key and reset to 0\n        # Remaining length = 50000 - flag_len\n        wrap_len = KEY_LEN - flag_len\n        wrap_payload = b'0' * wrap_len\n        \n        # Send wrap payload and wait for sync (expecting prompt after this)\n        print(f\"[+] Wrapping key pointer ({wrap_len} bytes)...\")\n        # Note: We do NOT expect the response content (it's garbage), just the prompt\n        send_and_sync(s, wrap_payload, expect_response=True)\n        print(\"[+] Key pointer wrapped. Sync successful.\")\n\n        # Step 3: Decrypt Flag\n        # Send C_flag. The server will XOR it with the key at index 0.\n        print(\"[+] Sending C_flag to recover plaintext...\")\n        response = send_and_sync(s, c_flag, expect_response=False)\n        \n        # The response from this last send might be captured or not depending on connection state.\n        # Let's try to read whatever is there immediately.\n        try:\n            final_data = s.recv(1024)\n        except:\n            final_data = b''\n            \n        full_response = response + final_data\n        final_text = full_response.decode('utf-8', errors='ignore')\n        \n        # Parse the flag\n        try:\n            # Look for the hex string that results from the decryption\n            # It should be the flag content (ASCII or Hex)\n            match = re.search(r'([0-9a-fA-F]{32,})', final_text)\n            if match:\n                result_hex = match.group(1)\n                # If it looks like hex, decode it\n                if len(result_hex) >= 32:\n                    flag_bytes = bytes.fromhex(result_hex)\n                    flag_str = flag_bytes.decode('utf-8', errors='ignore')\n                    \n                    # Check if readable\n                    if all(c.isprintable() or c in '\\n' for c in flag_str):\n                        print(f\"\\n[+] Recovered Flag: {flag_str}\")\n                    else:\n                        # Maybe it is already ASCII in the response\n                        # If the regex caught garbage, try to read the line after 'Here ya go!'\n                        lines = final_text.split('\\n')\n                        for line in lines:\n                            if 'Here ya go!' in line:\n                                continue\n                            if len(line) > 10:\n                                try:\n                                    b = bytes.fromhex(line.strip())\n                                    print(f\"[+] Decoded: {b.decode('utf-8')}\")\n                                except:\n                                    pass\n            else:\n                # If no long hex found, maybe the output is direct ASCII? (Unlikely for OTP)\n                print(\"[!] Could not find hex in response. Dumping content:\")\n                print(final_text)\n        except Exception as e:\n            print(f\"[-] Final parsing error: {e}\")\n            print(f\"Raw: {final_text}\")\n\n        s.close()\n\n    except Exception as e:\n        print(f\"Error: {e}\")\n\nif __name__ == \"__main__\":\n    solve()"}}
