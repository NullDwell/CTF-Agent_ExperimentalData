- 命令: {"tool": "sandbox_python_exec", "purpose": "编写并执行 Python 脚本以利用 OTP 密钥复用漏洞。脚本将处理服务器交互：1. 发送初始 16 字节数据获取 flag 密文（C_flag）。2. 发送足够长的数据（约 50000 字节）使 key_location 指针回到 0。3. 再次发送 C_flag 作为输入，服务器将执行 C_flag ^ key[0:16]，从而输出原始 flag。", "arguments": {"code": "import socket\nimport time\n\nhost = 'wily-courier.picoctf.net'\nport = 61145\nKEY_LEN = 50000\nFLAG_LEN = 16\n\ndef solve():\n    try:\n        # Step 1: Connect\n        s = socket.create_connection((host, port), timeout=10)\n        s.settimeout(5)\n        \n        # Read banner and C_flag\n        # The server sends: Banner, C_flag, Prompt\n        initial_data = b''\n        while b'What data would you like to encrypt?' not in initial_data:\n            initial_data += s.recv(4096)\n            if len(initial_data) > 2048: break\n        \n        text = initial_data.decode('utf-8', errors='ignore')\n        \n        # Parse C_flag\n        try:\n            lines = text.strip().split('\\n')\n            # Find the line containing the encrypted flag (it follows \"This is the encrypted flag!\")\n            c_flag_hex = \"\"\n            for i, line in enumerate(lines):\n                if \"This is the encrypted flag!\" in line:\n                    if i + 1 < len(lines):\n                        c_flag_hex = lines[i+1].strip()\n                        break\n            \n            if not c_flag_hex:\n                raise ValueError(\"Could not find C_flag\")\n                \n            c_flag = bytes.fromhex(c_flag_hex)\n            print(f\"[+] Found C_flag ({len(c_flag)} bytes): {c_flag_hex}\")\n            \n        except Exception as e:\n            print(f\"[-] Parsing error: {e}\")\n            return\n\n        # Step 2: Wrap around to reset key_location to 0\n        # Current key_location is FLAG_LEN (16)\n        # We need to consume (KEY_LEN - FLAG_LEN) bytes to wrap around\n        wrap_len = KEY_LEN - FLAG_LEN\n        \n        # Send wrap payload (zeros) followed by a newline to trigger processing\n        # Note: The server reads using input().rstrip(), so we must send a newline.\n        # The length consumed by encrypt is len(ui). \n        # If we send '0' * wrap_len + '\\n', ui length is wrap_len.\n        print(f\"[+] Sending {wrap_len} bytes to wrap key pointer...\")\n        \n        # Send in chunks to avoid buffer issues if any, though single send is fine for TCP usually\n        wrap_payload = (b'0' * (wrap_len - 1)) + b'\\n'\n        s.sendall(wrap_payload)\n        \n        # Discard the garbage response\n        s.recv(4096)\n        \n        # Step 3: Send C_flag to recover flag\n        # Now key_location is 0. Input is C_flag. Output is C_flag ^ Key[0:16] = Flag\n        print(f\"[+] Sending C_flag to decrypt...\")\n        s.sendall(c_flag + b'\\n')\n        \n        final_data = s.recv(4096).decode('utf-8', errors='ignore')\n        \n        # Parse the result\n        try:\n            lines = final_data.strip().split('\\n')\n            # The response should be \"Here ya go!\\n{decrypted_hex}\\n\"\n            flag_hex = lines[1]\n            flag_bytes = bytes.fromhex(flag_hex)\n            flag = flag_bytes.decode('utf-8', errors='ignore')\n            print(f\"\\n[+] Recovered Flag: {flag}\")\n            \n            # Check for valid flag format\n            if \"picoCTF{\" in flag:\n                print(\"[+] Flag format correct!\")\n            else:\n                print(\"[!] Flag format unexpected, printing hex just in case.\")\n                print(f\"Hex: {flag_hex}\")\n        except Exception as e:\n            print(f\"[-] Final parsing failed: {e}\")\n            print(f\"Raw response: {final_data}\")\n\n        s.close()\n\n    except Exception as e:\n        print(f\"Error: {e}\")\n\nif __name__ == \"__main__\":\n    solve()\n"}}
