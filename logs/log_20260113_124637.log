g in initial data\\")\\n                    return\\n            else:\\n                c_flag_hex = c_flag_match.group(1)\\n            \\n            c_flag = bytes.fromhex(c_flag_hex)\\n            print(f\\"[+] Found C_flag ({len(c_flag)} bytes): {c_flag_hex[:32]}...\\")\\n            \\n        except Exception as e:\\n            print(f\\"[-] Parsing error: {e}\\")\\n            return\\n\\n        # Step 3: Wrap around to reset key_location to 0\\n        # Current key_location is len(c_flag) (which is FLAG_LEN = 16)\\n        # We need to consume (KEY_LEN - current_location) bytes to wrap around\\n        wrap_len = KEY_LEN - len(c_flag)\\n        print(f\\"[+] Sending {wrap_len} bytes to wrap key pointer...\\")\\n        \\n        # Send wrap payload (zeros) followed by newline\\n        wrap_payload = (b\'0\' * (wrap_len - 1)) + b\'\\\\n\'\\n        s.sendall(wrap_payload)\\n        \\n        # Discard the garbage response from the wrap\\n        # The server will output \\"Here ya go!\\\\n{garbage_hex}\\\\n\\"\\n        # We read until we see the prompt again to ensure we are synced\\n        garbage_data = b\'\'\\n        while True:\\n            try:\\n                chunk = s.recv(4096)\\n                if not chunk: break\\n                garbage_data += chunk\\n                if b\'What data would you like to encrypt?\' in garbage_data:\\n                    break\\n            except socket.timeout:\\n                break\\n        \\n        # Step 4: Send C_flag to recover flag\\n        # Now key_location is 0. Input is C_flag. Output is C_flag ^ Key[0:16] = Flag\\n        print(f\\"[+] Sending C_flag to decrypt...\\")\\n        s.sendall(c_flag + b\'\\\\n\')\\n        \\n        final_data = b\'\'\\n        try:\\n            # Try to read more data to ensure we get the response\\n            while True:\\n                try:\\n                    chunk = s.recv(4096)\\n                    if not chunk: break\\n                    final_data += chunk\\n                    # If we have enough data or see the prompt again, we can stop\\n                    if len(final_data) > 1024: break\\n                    if b\'What data would you like to encrypt?\' in final_data: break\\n                except socket.timeout:\\n                    break\\n        except:\\n            pass\\n\\n        final_text = final_data.decode(\'utf-8\', errors=\'ignore\')\\n        \\n        # Parse the result\\n        try:\\n            # Look for the hex string in the response\\n            # The response should contain the decrypted flag\\n            match = re.search(r\'[0-9a-fA-F]{32,}\', final_text)\\n            if match:\\n                flag_hex = match.group(0)\\n                # The flag is 16 bytes (32 hex chars), but let\'s decode what we get\\n                # If the hex is longer, it might include garbage, but usually it matches flag length\\n                flag_bytes = bytes.fromhex(flag_hex)\\n                \\n                # If the flag bytes look like printable ASCII, try to decode\\n                # Otherwise print hex\\n                try:\\n                    flag_str = flag_bytes.decode(\'utf-8\')\\n                    if \'picoCTF\' in flag_str or any(c.isalnum() for c in flag_str):\\n                        print(f\\"\\\\n[+] Recovered Flag: {flag_str}\\")\\n                    else:\\n                        print(f\\"[+] Recovered Flag (Hex): {flag_hex}\\")\\n                except:\\n                    print(f\\"[+] Recovered Flag (Hex): {flag_hex}\\")\\n            else:\\n                print(\\"[-] Could not find flag in final response\\")\\n                print(f\\"Debug: {final_text}\\")\\n        except Exception as e:\\n            print(f\\"[-] Final parsing failed: {e}\\")\\n\\n        s.close()\\n\\n    except Exception as e:\\n        print(f\\"Error: {e}\\")\\n\\nif __name__ == \\"__main__\\":\\n    solve()"}}\n- 输出:\ntype=\'text\' text=\'[+] Found C_flag (32 by