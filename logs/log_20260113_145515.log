    try:\\n        hex_str = encrypted_data.decode(\'ascii\').strip()\\n        decoded_hex = bytes.fromhex(hex_str)\\n        \\n        key = \'QAPRBALLHNM\'\\n        res = bytearray()\\n        for i, b in enumerate(decoded_hex):\\n            res.append(b ^ ord(key[i % len(key)]))\\n        print(f\\"Hex Decode + XOR: {res.decode()}\\")\\n    except:\\n        print(\\"Hex decode failed\\")\\n\\n    # 可能性 2: 密钥隐藏在 arg133 的生成逻辑中\\n    # 我们手动构建一个与历史记录匹配的数组 \'a\'\\n    # 历史记录：a[71]... 构成 \'g@ppxBg@MBD\'\\n    # 这意味着 a 的长度至少为 81。\\n    # 让我们尝试构建一个简单的 a 数组，例如字母表或特定模式，看看是否能匹配。\\n    \\n    # 如果上述方法都失败，我们尝试手动分析 bloat.flag.py 的汇编/字节码来查找硬编码字符串。\\n    # 或者，尝试已知明文攻击：已知 flag 以 \'flag{\' 开头。\\n    # 密文头部是 0x40 (\'@\')。\\n    # 如果解密后是 \'f\' (0x66):\\n    # \'f\' ^ 0x40 = 0x26 (\'&\')\\n    # \'l\' ^ \'c\' = 0x6c ^ 0x63 = 0x0f\\n    # \'a\' ^ \'@\' = 0x61 ^ 0x40 = 0x21 (\'!\')\\n    # \'g\' ^ \'-\' = 0x67 ^ 0x2d = 0x4a (\'J\')\\n    # 这看起来不像密钥。说明可能存在位操作。\\n\\n    # 让我们尝试逆向 bloat 的典型位操作： (val >> 3) | ((val & 7) << 5)\\n    # 逆向：val = (val << 3) & 0xFF | (val >> 5)\\n    # 密文是 ASCII 字符，我们将其视为字节。\\n    \\n    print(\\"\\\\nTrying standard bloat bitwise reversal...\\")\\n    key = \'QAPRBALLHNM\'\\n    res = bytearray()\\n    for i, b in enumerate(encrypted_data):\\n        # 1. 逆向位操作 (假设加密时做了位移)\\n        # 注意：如果加密是 b\'@c@-\'，这些字节是 0x40, 0x63, ...\\n        dec_val = ((b << 3) & 0xFF) | (b >> 5)\\n        # 2. XOR\\n        res.append(dec_val ^ ord(key[i % len(key)]))\\n        \\n    try:\\n        print(f\\"RevBit + XOR: {res.decode()}\\")\\n    except:\\n        print(f\\"RevBit + XOR bytes: {res}\\")\\n\\n    # 再次尝试：如果密文是 Base64 编码的 Hex? \\n    # 或者，密钥是 \'QAPRBALLHNM\' 的变体。\\n    # 让我们尝试使用 \'QAPRBALLHNM\' 进行 XOR，然后逆向位移。\\n    \\n    res2 = bytearray()\\n    for i, b in enumerate(encrypted_data):\\n        val = b ^ ord(key[i % len(key)])\\n        dec_val = ((val << 3) & 0xFF) | (val >> 5)\\n        res2.append(dec_val)\\n        \\n    try:\\n        print(f\\"XOR + RevBit: