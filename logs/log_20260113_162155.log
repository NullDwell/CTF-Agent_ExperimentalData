- 命令: {"tool": "sandbox_python_exec", "purpose": "Calculate GCDs of the moduli to recover prime factors, then compute private exponents and sequentially decrypt the ciphertext three times to recover the flag.", "arguments": {"code": "import gmpy2\nfrom Crypto.Util.number import long_to_bytes\n\n# Read the public key file\nwith open('/home/gem/workspace/attachments/public-key.txt', 'r') as f:\n    lines = f.readlines()\n\n# Parse parameters\nparams = {}\nfor line in lines:\n    if ':' in line:\n        key, val = line.split(':', 1)\n        params[key.strip()] = int(val.strip())\n\nn1 = params['n1']\nn2 = params['n2']\nn3 = params['n3']\ne = params['e']\nc = params['c']\n\nprint(f\"[+] Read n1, n2, n3, e, c\")\n\n# 1. Recover factors using GCD\np = gmpy2.gcd(n1, n2)\nq = n1 // p\nr = n2 // p\n\nprint(f\"[+] Recovered factors: p={p}, q={q}, r={r}\")\n\n# 2. Helper function for RSA decryption\ndef rsa_decrypt(ciphertext, n, p, q):\n    phi = (p - 1) * (q - 1)\n    d = gmpy2.invert(e, phi)\n    m = pow(ciphertext, d, n)\n    return m\n\n# 3. Sequential Decryption\n# Step 1: Decrypt c (ciphertext for n3) to get c2\n# c = c2^e mod n3 => c2 = c^d3 mod n3\nprint(\"[+] Step 1: Decrypting with n3 (q, r)...\")\nm1 = rsa_decrypt(c, n3, q, r)\nprint(f\"    Decrypted intermediate value (c2): {m1}\")\n\n# Step 2: Decrypt c2 (which is ciphertext for n2) to get c1\n# c1 = m1^e mod n2 => m1 = c1^d2 mod n2 => c1 = m1^d2 mod n2\nprint(\"[+] Step 2: Decrypting with n2 (p, r)...\")\nm2 = rsa_decrypt(m1, n2, p, r)\nprint(f\"    Decrypted intermediate value (c1): {m2}\")\n\n# Step 3: Decrypt c1 (which is ciphertext for n1) to get flag\n# m = c1^e mod n1 => c1 = m^d1 mod n1 => m = c1^d1 mod n1\nprint(\"[+] Step 3: Decrypting with n1 (p, q)...\")\nflag_int = rsa_decrypt(m2, n1, p, q)\n\nprint(f\"\\n[+] Recovered Flag Integer: {flag_int}\")\nflag = long_to_bytes(flag_int)\nprint(f\"[+] Flag: {flag.decode()}\")\n"}}
