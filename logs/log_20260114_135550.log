1]\n            val = int(byte_str, 2)\n            if 32 <= val <= 126:\n                res += chr(val)\n            else:\n                res += '.'\n    return res\n\n# 尝试 1: 标准解码\nres_std = decode_ascii(final_binary_stream)\nprint(\"Standard ASCII (head):\", res_std[:200])\n\n# 尝试 2: 反转每个字节的位 (LSB First)\nres_rev_bits = decode_ascii(final_binary_stream, reverse_bits=True)\nprint(\"Reversed Bits ASCII (head):\", res_rev_bits[:200])\n\n# 尝试 3: 反转整个流的位顺序 (整流反转)\nreversed_stream = final_binary_stream[::-1]\nres_rev_stream = decode_ascii(reversed_stream)\nprint(\"Reversed Stream ASCII (head):\", res_rev_stream[:200])\n\n# 尝试 4: 检查十六进制\nhex_out = decode_hex(final_binary_stream)\nprint(\"Hex Output (head):\", hex_out[:100])\n\n# 尝试 5: 检查是否是加密的标志，尝试 XOR 0xFF 或其他简单变换\n# 也尝试将二进制流视为字节流并直接转换（处理不可打印字符）\nraw_bytes = bytes([int(final_binary_stream[i:i+8], 2) for i in range(0, len(final_binary_stream), 8)])\nprint(\"Raw bytes (first 20):\", raw_bytes[:20])\n\n# 查找 flag\nfor name, s in [(\"Standard\", res_std), (\"RevBits\", res_rev_bits), (\"RevStream\", res_rev_stream)]:\n    if \"flag\" in s.lower() or \"{\" in s:\n        print(f\"\\n*** POTENTIAL FLAG IN {name} ***\")\n        print(s[:500])\n"}}
