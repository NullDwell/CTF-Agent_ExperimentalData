_decoded = ''.join([chr(int(res_rev_stream[i:i+8], 2)) if int(res_rev_stream[i:i+8], 2) < 128 else '.' for i in range(0, len(res_rev_stream), 8)])\n\nprint('Standard (head):', res_std[:100])\nprint('Rev Bits (head):', res_rev_bits[:100])\nprint('Rev Stream (head):', res_rev_stream_decoded[:100])\n\n# 检查是否包含 flag 模式\nfor name, s in [('Std', res_std), ('RevBits', res_rev_bits), ('RevStream', res_rev_stream_decoded)]:\n    if 'flag' in s.lower() or '{' in s:\n        print(f'*** POTENTIAL FLAG IN {name} ***')\n        print(s[s.find('{') if '{' in s else 0:s.find('{')+50 if '{' in s else 100])\n\""}}
