def reverse_scramble_to_raw(fun, seed):
    fun_bin = bin(fun)[2:].zfill(60)
    occupied = [False] * 30
    P = []
    for i in range(30):
        y = (i * seed) % 30
        while occupied[y]: y = (y + 1) % 30
        occupied[y] = True
        P.append(y)
    raw = [''] * 30
    for i in range(30):
        pos = P[i]
        val_pair = fun_bin[2*pos : 2*pos+2]
        raw[i] = '0' if val_pair == '00' else '1'
    return ''.join(raw)

final_binary_stream = ''.join([reverse_scramble_to_raw(funs[i], seeds[i]) for i in range(BLOCKS_COUNT)])

# 尝试标准解码
res_std = ''.join([chr(int(final_binary_stream[i:i+8], 2)) if int(final_binary_stream[i:i+8], 2) < 128 else '.' for i in range(0, len(final_binary_stream), 8)])

