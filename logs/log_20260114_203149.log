步骤 3:
- 目的: 优化爆破脚本以增强连接稳定性，并采用更健壮的逻辑逐位解析 flag。
- 命令: {"tool": "sandbox_python_exec", "purpose": "优化爆破脚本以增强连接稳定性，并采用更健壮的逻辑逐位解析 flag。", "arguments": {"code": "import socket\nimport string\n\ndef get_len(payload, host='wily-courier.picoctf.net', port=61243):\n    try:\n        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n        s.settimeout(3)\n        s.connect((host, port))\n        # 接收直到出现输入提示\n        data = b\"\"\n        while b\"Enter your text\" not in data:\n            chunk = s.recv(1024)\n            if not chunk: break\n            data += chunk\n        \n        s.sendall(payload.encode() + b\"\\n\")\n        \n        # 接收响应，直到获取到最后的长度数字\n        res = b\"\"\n        while True:\n            chunk = s.recv(4096)\n            if not chunk: break\n            res += chunk\n            if len(res.strip().split(b'\\n')) >= 3: # nonce, encrypted_text, length\n                break\n        s.close()\n        \n        lines = res.strip().split(b'\\n')\n        return int(lines[-1].decode())\n    except Exception:\n        return 999\n\nknown = \"picoCTF{\"\ncharset = string.ascii_letters + string.digits + \"_!}\"\n\n# 连续多次尝试以应对网络波动和压缩边界问题\nwhile \"}\" not in known:\n    results = {}\n    for char in charset:\n        curr_payload = known + char\n        # 为了准确性，可以多次测量取最小值，但在这种压缩攻击中通常一次即可\n        l = get_len(curr_payload)\n        results[char] = l\n    \n    min_len = min(results.values())\n    candidates = [k for k, v in results.items() if v == min_len]\n    \n    if candidates:\n        # 如果有多个相同长度，优先选非 '}' 的，除非只剩下 '}'\n        if len(candidates) > 1 and \"}\" in candidates:\n            candidates.remove(\"}\")\n        known += candidates[0]\n        print(f\"Current flag: {known}\")\n    else:\n        print(\"Failed to find next character\")\n        break\n\nprint(f\"Final Flag: {known}\")"}}
