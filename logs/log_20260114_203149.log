- 命令: {"tool": "sandbox_python_exec", "purpose": "由于之前多次连接失败，怀疑是网络访问受限或连接管理问题。本次尝试采用单次连接尝试多个字符的策略，并加入更细致的错误处理和超时设置，同时打印具体的网络异常信息以诊断问题。", "arguments": {"code": "import socket\nimport string\nimport time\n\ndef check_char(current_flag, char):\n    host = 'wily-courier.picoctf.net'\n    port = 61243\n    payload = current_flag + char\n    try:\n        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n        s.settimeout(4)\n        s.connect((host, port))\n        \n        # 接收直到提示符\n        banner = b\"\"\n        start_time = time.time()\n        while b\"Enter your text\" not in banner:\n            chunk = s.recv(1024)\n            if not chunk or time.time() - start_time > 3:\n                break\n            banner += chunk\n        \n        s.sendall(payload.encode() + b\"\\n\")\n        \n        # 接收响应\n        response = b\"\"\n        start_time = time.time()\n        while time.time() - start_time < 3:\n            chunk = s.recv(4096)\n            if not chunk:\n                break\n            response += chunk\n            if len(response.strip().split(b'\\n')) >= 3:\n                break\n        s.close()\n        \n        lines = response.strip().split(b'\\n')\n        if len(lines) >= 3:\n            return int(lines[-1].decode())\n    except Exception as e:\n        return None\n    return None\n\nknown = \"picoCTF{\"\ncharset = string.ascii_lowercase + string.digits + \"_\" + string.ascii_uppercase + \"!}\"\n\nprint(f\"Initial check for {known}\")\n# 尝试获取基准长度或探测网络\nfor char in \"aeiou\":\n    res = check_char(known, char)\n    if res is not None:\n        print(f\"Test '{char}': {res}\")\n    else:\n        print(f\"Test '{char}': Connection Failed\")\n\n# 如果能连接成功，尝试爆破下一位\nif any(check_char(known, 'e') for _ in range(1)):\n    best_char = \"\"\n    min_len = 999\n    for char in charset:\n        l = check_char(known, char)\n        if l is not None:\n            if l < min_len:\n                min_len = l\n                best_char = char\n            print(f\"Char: {char} Len: {l}\")\n    \n    if best_char:\n        print(f\"Found next char: {best_char}\")"}}
