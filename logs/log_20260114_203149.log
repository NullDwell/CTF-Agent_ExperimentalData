- 命令: {"tool": "sandbox_python_exec", "purpose": "使用 pwntools 编写更健壮的脚本来执行 CRIME 攻击，通过监听和解析服务器返回的长度来逐位爆破 flag。", "arguments": {"code": "from pwn import *\nimport string\n\n# 禁用 pwntools 的日志输出以减少干扰\ncontext.log_level = 'error'\n\nhost = 'wily-courier.picoctf.net'\nport = 61243\n\ndef get_compressed_len(payload):\n    try:\n        # 建立连接\n        r = remote(host, port, timeout=5)\n        r.recvuntil(b'Enter your text to be encrypted:', timeout=5)\n        r.sendline(payload.encode())\n        # 接收响应，包含 nonce, ciphertext 和 length\n        # 根据代码，顺序是 nonce, ciphertext, len\n        r.recvline() # nonce\n        r.recvline() # encrypted_text\n        length_line = r.recvline().strip()\n        r.close()\n        return int(length_line)\n    except Exception as e:\n        return 999\n\nknown = \"picoCTF{\"\ncharset = string.ascii_letters + string.digits + \"_!}\"\n\nprint(f\"Starting attack with prefix: {known}\")\n\n# 逐字符尝试\nwhile \"}\" not in known:\n    best_chars = []\n    min_len = 1000\n    \n    # 我们尝试找到能导致最小压缩长度的字符\n    results = {}\n    for char in charset:\n        # 由于 zlib 算法特性，我们将 known + char 重复多次以增强压缩效果的区分度\n        # 题目逻辑是 compress(flag + usr_input)\n        # 如果 usr_input 包含 flag 的一部分，长度会减小\n        test_payload = known + char\n        l = get_compressed_len(test_payload)\n        results[char] = l\n        if l < min_len:\n            min_len = l\n\n    candidates = [c for c, l in results.items() if l == min_len]\n    \n    if not candidates:\n        print(\"No candidates found. Interrupted.\")\n        break\n    \n    # 优先选择非 '}' 字符以防提前结束\n    next_char = candidates[0]\n    if len(candidates) > 1 and next_char == '}' :\n        next_char = candidates[1]\n        \n    known += next_char\n    print(f\"Progress: {known}\")\n    \n    # 安全退出，防止进入死循环\n    if len(known) > 60:\n        break\n\nprint(f\"Final Flag: {known}\")"}}
